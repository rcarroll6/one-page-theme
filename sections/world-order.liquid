{% liquid
  assign featured_product = product
  if featured_product == blank
    assign featured_product = all_products['world-order-coffee']
  endif
  assign selected_variant = featured_product.selected_or_first_available_variant
%}

<section class="wo" data-section-id="{{ section.id }}">
  <div class="wo__scrim"></div>
  <header class="wo__header">
    <a class="wo__brand" href="{{ routes.root_url }}" aria-label="{{ 'general.home' | t }}">
      <img src="https://cdn.shopify.com/s/files/1/0509/8284/6628/files/original-stormtrooper-coffee-logo.png?v=1788537656" alt="Original Stormtrooper Coffee" width="880" height="882">
    </a>
    <nav class="wo__actions" aria-label="{{ 'general.account_navigation' | t }}">
      <a class="wo__account" href="https://account.originalstormtroopercoffee.com/">{{ 'general.my_account' | t }}</a>
      <a class="wo__cart" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart' | t }}">
        <span aria-hidden="true">◫</span> {{ 'general.cart' | t }} ({{ cart.item_count }})
      </a>
    </nav>
  </header>

  <div class="wo__content">
    <div class="wo__product-image">
      {% if featured_product.featured_image %}
        {{ featured_product.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '600,900,1200,1400', sizes: '(min-width: 900px) 56vw, 90vw', alt: featured_product.featured_image.alt }}
      {% endif %}
    </div>

    <div class="wo__buy">
      <p class="wo__eyebrow">{{ 'product.eyebrow' | t }}</p>
      <div class="wo__headline-row">
        <h1>{{ 'product.heading' | t }}</h1>
        <a class="wo__subscription-icon" href="/pages/coffee-subscription" aria-label="{{ 'subscription.icon_label' | t }}">
          <img src="https://cdn.shopify.com/s/files/1/0509/8284/6628/files/subscription-offer-coffee-icon.jpg?v=1788940305" alt="" width="1600" height="1600">
        </a>
      </div>
      <p class="wo__intro">{{ 'product.intro' | t }}</p>

      {% if featured_product != blank %}
        {% form 'product', featured_product, class: 'wo__form' %}
          <fieldset class="wo__options">
            <legend class="visually-hidden">{{ 'product.choose_format' | t }}</legend>
            {% assign format_option = featured_product.options_with_values | first %}
            {% for format_value in format_option.values %}
              {% assign beans_variant = blank %}
              {% assign ground_variant = blank %}
              {% for variant in featured_product.variants %}
                {% if variant.option1 == format_value and variant.option2 == 'Beans' %}
                  {% assign beans_variant = variant %}
                {% elsif variant.option1 == format_value and variant.option2 == 'Ground' %}
                  {% assign ground_variant = variant %}
                {% endif %}
              {% endfor %}
              <label class="wo__option">
                <input
                  type="radio"
                  name="world-order-format"
                  value="{{ format_value | escape }}"
                  data-beans-id="{{ beans_variant.id }}"
                  data-beans-price="{{ beans_variant.price | money }}"
                  data-beans-available="{{ beans_variant.available }}"
                  data-ground-id="{{ ground_variant.id }}"
                  data-ground-price="{{ ground_variant.price | money }}"
                  data-ground-available="{{ ground_variant.available }}"
                  {% if selected_variant.option1 == format_value %}checked{% endif %}
                  {% unless beans_variant.available or ground_variant.available %}disabled{% endunless %}
                >
                <span class="wo__radio"></span>
                <span class="wo__option-copy">
                  <strong>{{ format_value }}</strong>
                  <small>{% if format_value contains '250g' %}{{ 'product.bag_note' | t }}{% else %}{{ 'product.tin_note' | t }}{% endif %}</small>
                </span>
                <span class="wo__price">{{ beans_variant.price | money }}</span>
              </label>
            {% endfor %}
          </fieldset>
          {% comment %}Two-step selector: format first, then grind{% endcomment %}
          <label class="wo__grind-label" for="wo-grind-{{ section.id }}">{{ 'product.choose_grind' | t }}</label>
          <select class="wo__grind" id="wo-grind-{{ section.id }}">
            <option value="Beans" {% if selected_variant.option2 == 'Beans' %}selected{% endif %}>{{ 'product.beans' | t }}</option>
            <option value="Ground" {% if selected_variant.option2 == 'Ground' %}selected{% endif %}>{{ 'product.ground' | t }}</option>
          </select>
          <input class="wo__variant-id" type="hidden" name="id" value="{{ selected_variant.id }}">
          <button class="wo__button" type="submit" {% unless selected_variant.available %}disabled{% endunless %}>
            {{ 'product.purchase' | t }} · <span class="wo__button-price">{{ selected_variant.price | money }}</span>
          </button>
        {% endform %}
      {% else %}
        <p>{{ 'product.unavailable' | t }}</p>
      {% endif %}
    </div>
  </div>

  <section class="wo__coffee-details" aria-labelledby="wo-coffee-details-title-{{ section.id }}">
    <div class="wo__coffee-details-heading">
      <p class="wo__eyebrow">{{ section.settings.coffee_eyebrow }}</p>
      <h2 id="wo-coffee-details-title-{{ section.id }}">{{ section.settings.coffee_heading }}</h2>
      <div class="wo__coffee-intro">{{ section.settings.coffee_intro }}</div>
    </div>

    <dl class="wo__coffee-facts">
      <div><dt>{{ section.settings.origin_title }}</dt><dd>{{ section.settings.origin_text }}</dd></div>
      <div><dt>{{ section.settings.process_title }}</dt><dd>{{ section.settings.process_text }}</dd></div>
      <div><dt>{{ section.settings.roast_title }}</dt><dd>{{ section.settings.roast_text }}</dd></div>
      <div><dt>{{ section.settings.notes_title }}</dt><dd>{{ section.settings.notes_text }}</dd></div>
    </dl>

    <div class="wo__coffee-stories">
      <article><h3>{{ section.settings.coffee_story_title }}</h3><p>{{ section.settings.coffee_story_text }}</p></article>
      <article><h3>{{ section.settings.producer_title }}</h3><p>{{ section.settings.producer_text }}</p></article>
    </div>
  </section>

</section>

{% stylesheet %}
  :root{color-scheme:dark}*{box-sizing:border-box}.skip-link{position:absolute;left:-9999px}.skip-link:focus{left:16px;top:16px;z-index:20;background:#fff;color:#000;padding:12px}.visually-hidden{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.wo{min-height:100svh;position:relative;overflow:hidden;background:#100c09 url('https://cdn.shopify.com/s/files/1/0509/8284/6628/files/world-order-background-artwork.jpg?v=1788536886') center/cover fixed;color:#f3e5c3;font-family:Arial,Helvetica,sans-serif}.wo__scrim{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,6,5,.45),rgba(8,6,5,.3) 48%,rgba(8,6,5,.86) 75%),linear-gradient(0deg,rgba(8,6,5,.55),rgba(8,6,5,.12));backdrop-filter:saturate(.8)}.wo__header{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:flex-start;padding:24px 4vw}.wo__brand{display:block;width:clamp(82px,8vw,126px);border-radius:50%;overflow:hidden;box-shadow:0 8px 25px rgba(0,0,0,.45);transition:transform .2s ease}.wo__brand:hover{transform:scale(1.04)}.wo__brand img{display:block;width:100%;height:auto}.wo__actions{display:flex;align-items:flex-start;gap:18px}.wo__account,.wo__cart{color:#f3e5c3;text-decoration:none;font-weight:700;letter-spacing:.12em;font-size:.76rem;text-transform:uppercase;padding:12px}.wo__account:hover,.wo__cart:hover{color:#e8522f}.wo__subscription-icon{position:relative;display:block;flex:0 0 auto;width:118px;height:118px;margin:24px 4px 0;border:0;border-radius:50%;background:#000;box-shadow:0 9px 26px rgba(0,0,0,.5);overflow:hidden;transition:transform .2s ease}.wo__subscription-icon:hover{transform:scale(1.05)}.wo__subscription-icon img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;transform:scale(1.25)}.wo__content{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(340px,.75fr);align-items:end;gap:2vw;max-width:1600px;margin:0 auto;padding:0 4vw 4vw;min-height:calc(100svh - 130px)}.wo__product-image{align-self:end;display:flex;justify-content:center}.wo__product-image img{display:block;width:min(100%,900px);height:auto;filter:drop-shadow(0 28px 35px rgba(0,0,0,.55))}.wo__buy{align-self:center;max-width:520px;padding:28px 0}.wo__eyebrow{text-transform:uppercase;letter-spacing:.24em;color:#e85b38;font-weight:800;font-size:.72rem;margin:0 0 12px}.wo h1{font-family:Impact,Haettenschweiler,'Arial Narrow Bold',sans-serif;font-size:clamp(3rem,5vw,6rem);line-height:.88;letter-spacing:.01em;text-transform:uppercase;margin:0;max-width:8ch;color:#efe0bd;text-shadow:0 4px 20px #000}.wo__intro{font-size:clamp(1rem,1.2vw,1.18rem);line-height:1.55;max-width:42ch;color:#e5d7bf;margin:22px 0 26px}.wo__form{background:rgba(14,10,8,.82);border:1px solid rgba(235,216,178,.35);padding:20px;border-radius:14px;box-shadow:0 18px 50px rgba(0,0,0,.35);backdrop-filter:blur(12px)}.wo__options{border:0;padding:0;margin:0}.wo__option{display:grid;grid-template-columns:22px 1fr auto;align-items:center;gap:13px;padding:15px 14px;border:1px solid rgba(239,224,189,.28);border-radius:9px;margin-bottom:12px;cursor:pointer;transition:border-color .2s,background .2s}.wo__option:has(input:checked){border-color:#e8522f;background:rgba(232,82,47,.1)}.wo__option input{position:absolute;opacity:0}.wo__radio{width:18px;height:18px;border:2px solid #cdb990;border-radius:50%}.wo__option:has(input:checked) .wo__radio{border:5px solid #e8522f}.wo__option-copy{display:flex;flex-direction:column;gap:3px}.wo__option-copy strong{font-size:.82rem;letter-spacing:.14em;text-transform:uppercase}.wo__option-copy small{color:#bfae94}.wo__price{font-weight:800}.wo__grind-label{display:block;margin:4px 0 8px;color:#f3e5c3;font-size:.76rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.wo__grind{width:100%;margin:0 0 14px;padding:13px 42px 13px 14px;border:1px solid rgba(239,224,189,.4);border-radius:8px;background:#17110d;color:#f3e5c3;font:inherit;cursor:pointer}.wo__button{width:100%;border:0;border-radius:8px;padding:17px 20px;background:#e8522f;color:#fff;text-transform:uppercase;font-weight:900;letter-spacing:.14em;font-size:.9rem;cursor:pointer}.wo__button:hover{background:#ff633e}.wo__button:disabled{opacity:.5;cursor:not-allowed}@media(max-width:899px){.wo{background-attachment:scroll}.wo__header{padding:18px 22px}.wo__brand{width:82px}.wo__actions{gap:4px}.wo__account,.wo__cart{font-size:.68rem;padding:10px 6px}.wo__subscription-icon{width:84px;height:84px;margin-top:22px;border-width:0}.wo__content{grid-template-columns:1fr;padding:10px 22px 28px;gap:0}.wo__product-image img{width:min(100%,650px)}.wo__buy{max-width:none;padding-top:0}.wo h1{font-size:clamp(3rem,14vw,5rem)}.wo__scrim{background:linear-gradient(0deg,rgba(8,6,5,.92) 0%,rgba(8,6,5,.46) 62%,rgba(8,6,5,.35))}}
  .wo__headline-row{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:20px}.wo__headline-row .wo__subscription-icon{align-self:center;width:104px;height:104px;margin:28px 0 0;border:0;background:transparent;box-shadow:0 9px 26px rgba(0,0,0,.42)}.wo__headline-row .wo__subscription-icon img{width:100%;height:100%;object-fit:cover;transform:scale(1.21) translate(1.9%,-.8%)}@media(max-width:899px){.wo__headline-row{gap:12px}.wo__headline-row .wo__subscription-icon{width:88px;height:88px;margin-top:21px;transform:translateX(-3px)}}
  @media(min-width:900px){.wo__headline-row{grid-template-columns:auto 104px;justify-content:start;gap:10px}.wo__headline-row .wo__subscription-icon{margin-top:9px;transform:translateX(-7px)}}
  @media(min-width:900px) and (hover:hover) and (pointer:fine){.wo__headline-row .wo__subscription-icon:hover{transform:translate(-7px,-7px) scale(1.05)}}
  @media(min-width:900px){.wo__headline-row .wo__subscription-icon:focus-visible{outline:2px solid #f3e5c3;outline-offset:4px;transform:translate(-7px,-7px) scale(1.05)}}
  @media(max-width:899px){.wo__headline-row .wo__subscription-icon:active{transform:translate(-3px,-5px) scale(1.05)}}
  .wo__coffee-details{position:relative;z-index:1;max-width:1500px;margin:0 auto;padding:16px 4vw 64px}.wo__coffee-details-heading{max-width:900px;margin-bottom:20px}.wo__coffee-details-heading h2,.wo__coffee-stories h3{font-family:Impact,Haettenschweiler,'Arial Narrow Bold',sans-serif;text-transform:uppercase;letter-spacing:.02em;color:#efe0bd;margin:0}.wo__coffee-details-heading h2{font-size:clamp(2.6rem,5vw,4.8rem);line-height:.94}.wo__coffee-intro{color:#e5d7bf;line-height:1.55;margin-top:18px}.wo__coffee-intro p{margin:0 0 12px}.wo__coffee-facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:0 0 18px}.wo__coffee-facts>div,.wo__coffee-stories article{background:rgba(14,10,8,.88);border:1px solid rgba(235,216,178,.35);backdrop-filter:blur(12px)}.wo__coffee-facts>div{padding:19px}.wo__coffee-facts dt{color:#e85b38;font-size:.72rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;margin-bottom:8px}.wo__coffee-facts dd{color:#e5d7bf;margin:0;line-height:1.45}.wo__coffee-stories{display:grid;grid-template-columns:1fr 1fr;gap:18px}.wo__coffee-stories article{padding:28px}.wo__coffee-stories h3{font-size:clamp(2rem,3vw,3rem);margin-bottom:10px}.wo__coffee-stories p{color:#e5d7bf;line-height:1.6;margin:0}@media(max-width:899px){.wo__coffee-details{padding:10px 22px 48px}.wo__coffee-facts{grid-template-columns:1fr 1fr}.wo__coffee-stories{grid-template-columns:1fr}}@media(max-width:520px){.wo__coffee-facts{grid-template-columns:1fr}}
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-section-id]').forEach((section) => {
    const variantId = section.querySelector('.wo__variant-id');
    const buttonPrice = section.querySelector('.wo__button-price');
    const grind = section.querySelector('.wo__grind');
    const button = section.querySelector('.wo__button');
    const formats = section.querySelectorAll('input[name="world-order-format"]');
    const updateVariant = () => {
      const format = section.querySelector('input[name="world-order-format"]:checked');
      if (!format || !grind) return;
      const key = grind.value.toLowerCase();
      variantId.value = format.dataset[`${key}Id`];
      buttonPrice.textContent = format.dataset[`${key}Price`];
      button.disabled = format.dataset[`${key}Available`] !== 'true';
    };
    formats.forEach((input) => input.addEventListener('change', updateVariant));
    grind?.addEventListener('change', updateVariant);
    updateVariant();
  });
{% endjavascript %}

{% schema %}
{
  "name": "World Order storefront",
  "settings": [
    { "type": "header", "content": "Monthly coffee information" },
    { "type": "text", "id": "coffee_eyebrow", "label": "Small heading", "default": "This month's coffee" },
    { "type": "text", "id": "coffee_heading", "label": "Heading", "default": "1. World Order" },
    { "type": "richtext", "id": "coffee_intro", "label": "Introduction", "default": "<p>Deep in the Guatemalan highlands, an elite squad of Stormtroopers marches across a remote coffee farm in pursuit of the galaxy’s most powerful beans. Their mission: seize control of the harvest and establish a bold new <strong>World Order</strong>—one cup at a time.</p><p>This is Ceiba coffee and it symbolises the connection between the land and the sky. What a glorious way to mark our return from the sky than to land on the richest soil in Guatemala.</p>" },
    { "type": "text", "id": "origin_title", "label": "Origin heading", "default": "Origin" },
    { "type": "text", "id": "origin_text", "label": "Origin", "default": "Huehuetenango, Guatemala" },
    { "type": "text", "id": "process_title", "label": "Process heading", "default": "Process" },
    { "type": "text", "id": "process_text", "label": "Process", "default": "Washed" },
    { "type": "text", "id": "roast_title", "label": "Roast heading", "default": "Roast" },
    { "type": "text", "id": "roast_text", "label": "Roast", "default": "Medium-Dark" },
    { "type": "text", "id": "notes_title", "label": "Tasting notes heading", "default": "Tasting notes" },
    { "type": "text", "id": "notes_text", "label": "Tasting notes", "default": "Dark Chocolate, Dried Cherry, Toffee" },
    { "type": "text", "id": "coffee_story_title", "label": "Coffee information heading", "default": "About this coffee" },
    { "type": "textarea", "id": "coffee_story_text", "label": "Coffee information", "default": "Ceiba is a bright, beautifully balanced coffee, bringing together juicy notes of cherry and apricot with a rich chocolate base and a luxuriously creamy mouthfeel. Its lively acidity and smooth, comforting finish make it a wonderfully versatile choice for a wide range of brewing methods." },
    { "type": "text", "id": "producer_title", "label": "Producer heading", "default": "The producer" },
    { "type": "textarea", "id": "producer_text", "label": "Producer information", "default": "This is Ceiba coffee and it symbolises the connection between the land and the sky. What a glorious way to mark our return from the sky than to land on this, the richest mountainous soil in Guatemala." }
  ],
  "presets": [
    {
      "name": "World Order storefront"
    }
  ]
}
{% endschema %}
