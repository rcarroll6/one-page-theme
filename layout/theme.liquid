<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#100c09">
    <title>{{ page_title | escape }}</title>
    <style>
      :root{--world-order-background:url('https://cdn.shopify.com/s/files/1/0509/8284/6628/files/world-order-background-artwork.jpg?v=1788536886')}.skip-link{position:fixed;top:12px;left:12px;z-index:9999;transform:translateY(-180%);padding:12px 16px;border-radius:6px;background:#fff;color:#111;font:700 14px/1 Arial,sans-serif;text-decoration:none}.skip-link:focus{transform:translateY(0);outline:3px solid #e8522f;outline-offset:2px}.site-footer{position:relative;z-index:4;padding:22px;text-align:center;background:#100c09;color:#d8c8a7;font:700 12px/1.4 Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase}.site-footer nav{display:flex;justify-content:center;gap:22px;flex-wrap:wrap}.site-footer a{color:inherit;text-decoration:none;border-bottom:1px solid rgba(216,200,167,.45)}.site-footer a:hover{color:#fff;border-color:#e8522f}
    </style>
    {{ content_for_header }}
  </head>
  <body>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    <footer class="site-footer">
      <nav aria-label="{{ 'footer.information' | t }}">
        <a href="/pages/licensing">{{ 'footer.licensing' | t }}</a>
        <a href="/pages/privacy-policy">{{ 'footer.privacy_policy' | t }}</a>
      </nav>
    </footer>
  </body>
</html>
