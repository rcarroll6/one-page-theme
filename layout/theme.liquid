<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#100c09">
    <title>{{ page_title | escape }}</title>
    <style>
      .skip-link{position:fixed;top:12px;left:12px;z-index:9999;transform:translateY(-180%);padding:12px 16px;border-radius:6px;background:#fff;color:#111;font:700 14px/1 Arial,sans-serif;text-decoration:none}.skip-link:focus{transform:translateY(0);outline:3px solid #e8522f;outline-offset:2px}
    </style>
    {{ content_for_header }}
  </head>
  <body>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
