<section class="licensing-page">
  <div class="licensing-page__scrim"></div>
  <header class="licensing-page__header">
    <a class="licensing-page__logo" href="{{ routes.root_url }}" aria-label="{{ 'general.home' | t }}">
      <img src="https://cdn.shopify.com/s/files/1/0509/8284/6628/files/original-stormtrooper-coffee-logo.png?v=1788537656" alt="Original Stormtrooper Coffee" width="880" height="882">
    </a>
    <a class="licensing-page__cart" href="{{ routes.cart_url }}">{{ 'general.cart' | t }} ({{ cart.item_count }})</a>
  </header>
  <article class="licensing-page__content">
    <p class="licensing-page__eyebrow">{{ 'licensing.eyebrow' | t }}</p>
    <h1>{{ 'licensing.title' | t }}</h1>
    <h2>{{ 'licensing.brand' | t }}</h2>
    <p>{{ 'licensing.first_paragraph' | t }}</p>
    <p>{{ 'licensing.second_paragraph' | t }}</p>
    <img class="licensing-page__approval" src="https://cdn.shopify.com/s/files/1/0509/8284/6628/files/shepperton-design-studios-approval.webp?v=1788542706" alt="{{ 'licensing.approval_alt' | t }}" width="600" height="261">
    <a class="licensing-page__return" href="{{ routes.root_url }}">{{ 'licensing.return' | t }}</a>
  </article>
</section>
<style>
  body{margin:0;background:#100c09;color:#f1e2bd;font-family:Arial,sans-serif}.licensing-page{position:relative;min-height:calc(100svh - 58px);overflow:hidden;background:#100c09 var(--world-order-background) center/cover fixed}.licensing-page__scrim{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,6,5,.62),rgba(8,6,5,.82)),linear-gradient(0deg,rgba(8,6,5,.78),rgba(8,6,5,.24))}.licensing-page__header{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:flex-start;padding:24px 4vw}.licensing-page__logo{display:block;width:clamp(82px,8vw,126px);border-radius:50%;overflow:hidden;box-shadow:0 8px 25px rgba(0,0,0,.45)}.licensing-page__logo img{display:block;width:100%;height:auto}.licensing-page__cart{color:#f3e5c3;text-decoration:none;font-weight:700;letter-spacing:.16em;font-size:.82rem;padding:12px}.licensing-page__content{position:relative;z-index:1;width:min(760px,calc(100% - 40px));margin:10px auto 70px;padding:clamp(28px,6vw,64px);text-align:center;background:rgba(14,10,8,.88);border:1px solid rgba(235,216,178,.35);border-radius:16px;box-shadow:0 22px 70px rgba(0,0,0,.5);backdrop-filter:blur(14px)}.licensing-page__eyebrow{margin:0 0 14px!important;text-transform:uppercase;letter-spacing:.24em;color:#e85b38!important;font-weight:800;font-size:.72rem!important}.licensing-page h1{font-family:Impact,Haettenschweiler,'Arial Narrow Bold',sans-serif;font-size:clamp(3.4rem,8vw,6rem);line-height:.9;text-transform:uppercase;margin:0;color:#efe0bd}.licensing-page h2{margin:22px 0 28px;font-size:clamp(1.1rem,2vw,1.45rem);letter-spacing:.14em}.licensing-page p{font-size:clamp(1rem,1.4vw,1.15rem);line-height:1.7;color:#e5d7bf}.licensing-page__approval{display:block;width:min(100%,460px);height:auto;margin:34px auto 24px;filter:invert(1) sepia(.18);opacity:.92}.licensing-page__return{display:inline-block;margin-top:12px;padding:13px 20px;border:1px solid #8c745c;border-radius:7px;color:#f1e2bd;text-decoration:none;text-transform:uppercase;font-size:.75rem;font-weight:800;letter-spacing:.12em}.licensing-page__return:hover{border-color:#e8522f;color:#fff}@media(max-width:680px){.licensing-page{background-attachment:scroll}.licensing-page__header{padding:18px 22px}.licensing-page__logo{width:82px}.licensing-page__content{margin-top:4px;padding:30px 22px}.licensing-page h1{font-size:3.4rem}}
</style>
