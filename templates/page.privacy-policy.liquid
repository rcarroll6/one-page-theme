<section class="policy-page">
  <div class="policy-page__scrim"></div>
  <header class="policy-page__header">
    <a class="policy-page__logo" href="{{ routes.root_url }}" aria-label="{{ 'general.home' | t }}">
      <img src="https://cdn.shopify.com/s/files/1/0509/8284/6628/files/original-stormtrooper-coffee-logo.png?v=1788537656" alt="Original Stormtrooper Coffee" width="880" height="882">
    </a>
    <a class="policy-page__cart" href="{{ routes.cart_url }}">{{ 'general.cart' | t }} ({{ cart.item_count }})</a>
  </header>
  <article class="policy-page__content">
    <p class="policy-page__eyebrow">{{ 'privacy.eyebrow' | t }}</p>
    <h1>{{ page.title }}</h1>
    <div class="policy-page__body">{{ page.content }}</div>
    <a class="policy-page__return" href="{{ routes.root_url }}">{{ 'privacy.return' | t }}</a>
  </article>
</section>
<style>
  body{margin:0;background:#100c09;color:#f1e2bd;font-family:Arial,sans-serif}.policy-page{position:relative;min-height:calc(100svh - 58px);overflow:hidden;background:#100c09 var(--world-order-background) center/cover fixed}.policy-page__scrim{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,6,5,.68),rgba(8,6,5,.86)),linear-gradient(0deg,rgba(8,6,5,.8),rgba(8,6,5,.3))}.policy-page__header{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:flex-start;padding:24px 4vw}.policy-page__logo{display:block;width:clamp(82px,8vw,126px);border-radius:50%;overflow:hidden;box-shadow:0 8px 25px rgba(0,0,0,.45)}.policy-page__logo img{display:block;width:100%;height:auto}.policy-page__cart{color:#f3e5c3;text-decoration:none;font-weight:700;letter-spacing:.16em;font-size:.82rem;padding:12px}.policy-page__content{position:relative;z-index:1;width:min(920px,calc(100% - 40px));box-sizing:border-box;margin:10px auto 70px;padding:clamp(28px,6vw,64px);background:rgba(14,10,8,.9);border:1px solid rgba(235,216,178,.35);border-radius:16px;box-shadow:0 22px 70px rgba(0,0,0,.5);backdrop-filter:blur(14px)}.policy-page__eyebrow{margin:0 0 14px!important;text-align:center;text-transform:uppercase;letter-spacing:.24em;color:#e85b38!important;font-weight:800;font-size:.72rem!important}.policy-page h1{font-family:Impact,Haettenschweiler,'Arial Narrow Bold',sans-serif;font-size:clamp(3rem,7vw,5.4rem);line-height:.95;text-align:center;text-transform:uppercase;margin:0 0 44px;color:#efe0bd}.policy-page__body{color:#e5d7bf;font-size:1rem;line-height:1.7}.policy-page__body>h1:first-child{display:none}.policy-page__body h2{margin:42px 0 14px;color:#efe0bd;font-size:1.35rem;line-height:1.25;letter-spacing:.08em}.policy-page__body h3{color:#efe0bd}.policy-page__body p{margin:0 0 18px}.policy-page__body ol,.policy-page__body ul{margin:0 0 22px;padding-left:28px}.policy-page__body li{margin-bottom:7px}.policy-page__body a{color:#f3c78a}.policy-page__body table:empty{display:none}.policy-page__return{display:block;width:max-content;margin:42px auto 0;padding:13px 20px;border:1px solid #8c745c;border-radius:7px;color:#f1e2bd;text-decoration:none;text-transform:uppercase;font-size:.75rem;font-weight:800;letter-spacing:.12em}.policy-page__return:hover{border-color:#e8522f;color:#fff}@media(max-width:680px){.policy-page{background:none}.policy-page::before{content:'';position:fixed;inset:0;z-index:0;background:#100c09 var(--world-order-background) center/cover no-repeat}.policy-page__header{padding:18px 22px}.policy-page__logo{width:82px}.policy-page__content{margin-top:4px;padding:30px 22px}.policy-page h1{font-size:3.2rem;margin-bottom:34px}.policy-page__body{font-size:.95rem}.policy-page__body h2{font-size:1.15rem}}
</style>
