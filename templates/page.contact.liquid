<section class="contact-page">
  <div class="contact-page__scrim"></div>
  <header class="contact-page__header">
    <a class="contact-page__logo" href="{{ routes.root_url }}" aria-label="{{ 'general.home' | t }}">
      <img src="https://cdn.shopify.com/s/files/1/0509/8284/6628/files/original-stormtrooper-coffee-logo.png?v=1788537656" alt="Original Stormtrooper Coffee" width="880" height="882">
    </a>
    <a class="contact-page__cart" href="{{ routes.cart_url }}">{{ 'general.cart' | t }} ({{ cart.item_count }})</a>
  </header>
  <article class="contact-page__content">
    <p class="contact-page__eyebrow">{{ 'contact.eyebrow' | t }}</p>
    <h1>{{ 'contact.title' | t }}</h1>
    <p class="contact-page__intro">{{ 'contact.intro' | t }}</p>
    <div class="contact-page__options">
      <section class="contact-page__option">
        <h2>{{ 'contact.email_title' | t }}</h2>
        <p>{{ 'contact.email_text' | t }}</p>
        <a class="contact-page__button contact-page__button--email" href="mailto:sales@OriginalStormtrooperCoffee.com">sales@OriginalStormtrooperCoffee.com</a>
      </section>
      <section class="contact-page__option">
        <h2>{{ 'contact.whatsapp_title' | t }}</h2>
        <p>{{ 'contact.whatsapp_text' | t }}</p>
        <p class="contact-page__notice">{{ 'contact.text_only' | t }}</p>
        <a class="contact-page__button contact-page__button--accent" href="https://wa.me/447418362987" target="_blank" rel="noopener">{{ 'contact.whatsapp_button' | t }}</a>
      </section>
    </div>
    <p class="contact-page__mystery">{{ 'contact.mystery' | t }}</p>
    <a class="contact-page__return" href="{{ routes.root_url }}">{{ 'contact.return' | t }}</a>
  </article>
</section>
<style>
  body{margin:0;background:#100c09;color:#f1e2bd;font-family:Arial,sans-serif}.contact-page{position:relative;min-height:calc(100svh - 58px);overflow:hidden;background:#100c09 var(--world-order-background) center/cover fixed}.contact-page__scrim{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,6,5,.62),rgba(8,6,5,.82)),linear-gradient(0deg,rgba(8,6,5,.78),rgba(8,6,5,.24))}.contact-page__header{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:flex-start;padding:24px 4vw}.contact-page__logo{display:block;width:clamp(82px,8vw,126px);border-radius:50%;overflow:hidden;box-shadow:0 8px 25px rgba(0,0,0,.45)}.contact-page__logo img{display:block;width:100%;height:auto}.contact-page__cart{color:#f3e5c3;text-decoration:none;font-weight:700;letter-spacing:.16em;font-size:.82rem;padding:12px}.contact-page__content{position:relative;z-index:1;width:min(820px,calc(100% - 40px));box-sizing:border-box;margin:10px auto 70px;padding:clamp(28px,6vw,64px);text-align:center;background:rgba(14,10,8,.9);border:1px solid rgba(235,216,178,.35);border-radius:16px;box-shadow:0 22px 70px rgba(0,0,0,.5);backdrop-filter:blur(14px)}.contact-page__eyebrow{margin:0 0 14px!important;text-transform:uppercase;letter-spacing:.24em;color:#e85b38!important;font-weight:800;font-size:.72rem!important}.contact-page h1{font-family:Impact,Haettenschweiler,'Arial Narrow Bold',sans-serif;font-size:clamp(3.2rem,8vw,5.8rem);line-height:.9;text-transform:uppercase;margin:0;color:#efe0bd}.contact-page__intro{max-width:620px;margin:24px auto 34px;color:#e5d7bf;font-size:1.08rem;line-height:1.7}.contact-page__options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;text-align:left}.contact-page__option{display:flex;flex-direction:column;padding:25px;border:1px solid rgba(235,216,178,.24);border-radius:12px;background:rgba(255,255,255,.035)}.contact-page__option h2{margin:0 0 12px;color:#efe0bd;font-size:1.2rem;letter-spacing:.08em;text-transform:uppercase}.contact-page__option p{margin:0 0 18px;color:#d9cbb4;line-height:1.55}.contact-page__notice{color:#e85b38!important;font-size:.78rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.contact-page__button{display:block;margin-top:auto;padding:14px 16px;border:1px solid #8c745c;border-radius:7px;color:#f1e2bd;text-align:center;text-decoration:none;font-size:.86rem;font-weight:800;overflow-wrap:anywhere}.contact-page__button:hover{border-color:#e8522f;color:#fff}.contact-page__button--email{font-size:.76rem;white-space:nowrap}.contact-page__button--accent{background:#e8522f;border-color:#e8522f;color:#fff;text-transform:uppercase;letter-spacing:.08em}.contact-page__mystery{margin:28px auto 0;color:#b9aa93;font-size:.92rem;font-style:italic;line-height:1.6}.contact-page__return{display:inline-block;margin-top:28px;padding:13px 20px;border:1px solid #8c745c;border-radius:7px;color:#f1e2bd;text-decoration:none;text-transform:uppercase;font-size:.75rem;font-weight:800;letter-spacing:.12em}.contact-page__return:hover{border-color:#e8522f;color:#fff}@media(max-width:680px){.contact-page{background-attachment:scroll}.contact-page__header{padding:18px 22px}.contact-page__logo{width:82px}.contact-page__content{margin-top:4px;padding:30px 22px}.contact-page h1{font-size:3.4rem}.contact-page__options{grid-template-columns:1fr}.contact-page__button{font-size:.8rem}.contact-page__button--email{font-size:clamp(.66rem,3vw,.8rem)}}
</style>
